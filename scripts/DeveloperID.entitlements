<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- AVS presets compile EEL code to machine code at runtime (EEL2's JIT, MAP_JIT pages);
         the hardened runtime refuses executable memory without this. See skills/avs-port. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
