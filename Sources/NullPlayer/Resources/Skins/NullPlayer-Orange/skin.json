{
    "meta": {
        "name": "NullPlayer-Orange",
        "author": "NullPlayer",
        "version": "1.0",
        "description": "The app icon itself: orange-to-yellow glossy body, white-blue glyph, lemon rim glow"
    },
    "palette": {
        "primary": "#ffffff",
        "secondary": "#fff685",
        "accent": "#fff685",
        "highlight": "#ffffff",
        "background": "#f88500",
        "surface": "#ff7a00",
        "text": "#ffffff",
        "textDim": "#ffe2a0",
        "positive": "#fff685",
        "negative": "#c03000",
        "warning": "#fff685",
        "border": "#fff685",
        "timeColor": "#f6f8ff",
        "marqueeColor": "#ffffff",
        "dataColor": "#fff4d0",
        "eqLow": "#fff685",
        "eqMid": "#fffbe0",
        "eqHigh": "#d1dff7"
    },
    "fonts": {
        "primaryName": "DepartureMono-Regular",
        "fallbackName": "Menlo",
        "titleSize": 9,
        "bodySize": 10,
        "smallSize": 7,
        "timeSize": 22,
        "infoSize": 6.5,
        "eqLabelSize": 7,
        "eqValueSize": 6,
        "marqueeSize": 12.5,
        "playlistSize": 8
    },
    "background": {
        "image": "background.png"
    },
    "glow": {
        "enabled": true,
        "radius": 12,
        "intensity": 0.55,
        "threshold": 0.7,
        "color": "#fff685",
        "elementBlur": 0.7
    },
    "window": {
        "borderWidth": 1.5,
        "borderColor": "#fff685",
        "cornerRadius": 16,
        "opacity": 1.0,
        "textOpacity": 1.0,
        "mainSpectrumOpacity": 1.0,
        "seamlessDocking": 1.0
    },
    "marquee": {
        "scrollSpeed": 28,
        "scrollGap": 56
    },
    "elements": {
        "titlebar": { "color": "#ff9a10" },
        "spectrum_titlebar": { "color": "#ff9a10" },
        "playlist_titlebar": { "color": "#ff9a10" },
        "eq_titlebar": { "color": "#ff9a10" },
        "library_titlebar": { "color": "#ff9a10" },
        "projectm_titlebar": { "color": "#ff9a10" },
        "marquee_bg": { "color": "#ff7a00" },
        "play_controls": { "color": "#f6f8ff" },
        "seek_fill": { "color": "#ffffff" },
        "volume_fill": { "color": "#fff685" },
        "spectrum_area": { "color": "#ffffff" },
        "minicontrol_buttons": { "color": "#ffffff" },
        "playlist_text": { "color": "#fff4d0" },
        "tab_outline": { "color": "#fff685" },
        "tab_text": { "color": "#ffffff" }
    },
    "animations": {
        "seek_fill": {
            "type": "glow",
            "duration": 3.0,
            "minValue": 0.5,
            "maxValue": 1.0
        }
    },
    "visualization": {
        "mainWindowMode": "Cava",
        "spectrumWindowMode": "vis_classic",
        "visClassic": {
            "mainWindowProfile": "Flames",
            "spectrumWindowProfile": "Flames",
            "mainWindowFitToWidth": true,
            "spectrumWindowFitToWidth": true
        },
        "fire": {
            "mainWindowStyle": "Inferno",
            "mainWindowIntensity": "Intense",
            "spectrumWindowStyle": "Inferno",
            "spectrumWindowIntensity": "Intense"
        },
        "lightning": {
            "mainWindowStyle": "Ember",
            "spectrumWindowStyle": "Ember"
        },
        "matrix": {
            "mainWindowColorScheme": "Amber",
            "mainWindowIntensity": "Intense",
            "spectrumWindowColorScheme": "Amber",
            "spectrumWindowIntensity": "Intense"
        }
    }
}
